+  monkeypatch.setattr(la, 'APPROVED_CONSTRAINT_CONFLICT_POLICIES', (TEST_POLICY,))
+  o = ctrl.update(inp(41 * DT, shift, left, right))
+  assert ctrl.active and o.applied == 0.0 and not o.permitted
+
