+    for _ in range(40):
+      outs.append(ctrl.update(inp(t, shift, left, right)))
+      t += DT
+    assert outs[0].applied == 0.0
+    assert ctrl.mode_inactive(t).applied == 0.0
+    t += 3 * DT
+
