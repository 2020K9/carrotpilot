diff --git a/openpilot/selfdrive/controls/lib/lateral_planner.py b/openpilot/selfdrive/controls/lib/lateral_planner.py
index c0e5a1c4..3fdcce7e 100644
--- a/openpilot/selfdrive/controls/lib/lateral_planner.py
+++ b/openpilot/selfdrive/controls/lib/lateral_planner.py
@@ -13,6 +13,8 @@ from openpilot.common.params import Params
 #from openpilot.selfdrive.controls.lib.lane_planner import LanePlanner
 from openpilot.selfdrive.controls.lib.lane_planner_2 import LanePlanner
 from openpilot.selfdrive.controls.lib.lane_model_speed import LaneModelSpeedGuard
