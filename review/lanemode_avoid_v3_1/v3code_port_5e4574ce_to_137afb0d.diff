+def road_on(direction, x, y_out):
+  """road edge on `direction` at outward distance y_out (array over x); the other side at 5 m."""
+  road = edges()
+  road[direction] = (x, la.SIDE_SIGN[direction] * np.asarray(y_out, dtype=float), 0.1, 0.0)
+  return road
